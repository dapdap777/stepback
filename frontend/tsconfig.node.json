{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsc-node"
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
